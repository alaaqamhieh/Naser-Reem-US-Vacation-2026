# Copy this file to .env and fill in real values for local development.
# In production these are injected at build time from GitHub Actions repo
# secrets of the same names (see .github/workflows/deploy.yml) — never
# commit real values here.

# Google Cloud API key with "Places API (New)" enabled — powers the
# "Search for a place" feature in the Things To Do library. Restrict it by
# HTTP referrer to your github.io domain in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Realtime Database URL (e.g. https://xxxx-default-rtdb.firebaseio.com)
# — the shared "brain" so everyone's edits show up everywhere. Leave blank
# to run fully local/offline, same as before this feature existed.
VITE_FIREBASE_DB_URL=
